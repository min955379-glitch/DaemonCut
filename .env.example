# Copy to .env for local use. Keep .env out of Git; never commit API keys.
# The path must be inside Google Drive for desktop's locally accessible,
# synced/mirrored storage and end in DaemonCut Development or DaemonCut.
GDRIVE_DAEMONCUT_PATH=

# Gemini cloud generation (optional). If absent or unavailable, the brain can
# use the local Ollama service instead. Do not put quotes around simple values.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-4-hydrogen
GEMINI_TIMEOUT_SECONDS=90

# Phase 4 official publishing adapters. Each platform is configured separately;
# Meta is optional and falls back to a Ready-to-Post Drive bundle when disabled.
# Enter secrets only in the local key-vault UI or this ignored .env file.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_PRIVACY_STATUS=private
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
META_APP_ID=
META_APP_SECRET=
META_API_ENABLED=true
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_USER_ID=
META_GRAPH_API_VERSION=v22.0
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/callback
SOCIAL_HTTP_TIMEOUT_SECONDS=60
SOCIAL_UPLOAD_CHUNK_BYTES=8388608
SOCIAL_STATUS_POLL_ATTEMPTS=6
SOCIAL_STATUS_POLL_SECONDS=2

# Ollama local/offline fallback. Install Ollama separately and keep its model
# store under <GDRIVE_DAEMONCUT_PATH>\models\ollama to avoid filling the NVMe.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=10m

# Phase 2 audio defaults. Voice cloning endpoints must bind to localhost; the
# engine refuses to send reference voice audio to a remote host.
EDGE_TTS_ENABLED=true
KOKORO_ENABLED=true
POCKET_TTS_COMMAND=
POCKET_TTS_API_URL=
CHATTERBOX_API_URL=
AUDIO_SAMPLE_RATE=48000
AUDIO_TARGET_LUFS=-14
AUDIO_TRUE_PEAK_DBFS=-1
AUDIO_LOUDNESS_RANGE=11
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
WHISPER_CPP_BINARY=whisper-cli
REALESRGAN_NCNN_VULKAN_BINARY=

# Local RSS trend scout. The default endpoint is a public Google Trends RSS feed.
TREND_RSS_URL=https://trends.google.com/trending/rss?geo={country}
TREND_FETCH_TIMEOUT_SECONDS=12

# Phase 3 local API and QR bridge. The FastAPI service binds to all interfaces
# for same-Wi-Fi phone uploads, uses one worker, and caps async worker threads at 6.
API_HOST=0.0.0.0
API_PORT=8000
API_THREADPOOL_WORKERS=6
BRIDGE_UPLOAD_MAX_BYTES=536870912
YT_DLP_MAX_DURATION_SECONDS=21600
YT_DLP_MAX_FILESIZE_BYTES=5368709120
BROWSER_SCRAPE_TIMEOUT_SECONDS=25

# Asia/Karachi schedule: 21:30 and 00:30, with bounded startup network retry.
PKT_PEAK_WINDOW_MINUTES=15
BOOT_NETWORK_RETRIES=6
BOOT_NETWORK_BASE_DELAY_SECONDS=2
BOOT_NETWORK_MAX_DELAY_SECONDS=30
SCHEDULER_POLL_SECONDS=60
SCHEDULER_AUTOSTART=true
# Enable only for a logon task that should stop the API after an idle/completed
# boot cycle; leave false for a long-running interactive studio server.
SCHEDULER_BOOT_AUTORUN=false

# Local runtime controls. Only cache/temporary files older than this are eligible
# for cleanup; source footage, Drive assets, the SQLite DB and renders are never
# auto-deleted.
NVME_CACHE_TTL_HOURS=24

# Optional SQLite override; by default the small metadata DB stays in .daemoncut.
# DATABASE_PATH=C:\Users\YourName\AppData\Local\DaemonCut\daemoncut.sqlite3
